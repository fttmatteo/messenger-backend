    <!-- ===================================== -->
    <!-- LOGGERS ESPECÍFICOS POR COMPONENTE   -->
    <!-- ===================================== -->

    <!-- Logger para manejo global de excepciones -->
    <logger name="app.infrastructure.config.GlobalExceptionHandler" level="ERROR" additivity="false">
        <appender-ref ref="CONSOLE_DEV"/>
    </logger>

    <!-- Logger para servicios externos (Google Maps, Plate Recognizer, Cloud Storage) -->
    <logger name="app.adapter.out.maps" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE_DEV"/>
    </logger>

    <logger name="app.adapter.out.ocr" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE_DEV"/>
    </logger>

    <logger name="app.adapter.out.storage" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE_DEV"/>
    </logger>

    <!-- Logger para tracking de mensajeros -->
    <logger name="app.adapter.out.tracking" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE_DEV"/>
    </logger>

    <!-- Logger para seguridad y autenticación -->
    <logger name="app.adapter.out.security" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE_DEV"/>
    </logger>

    <logger name="app.infrastructure.security" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE_DEV"/>
    </logger>

    <!-- Logger para casos de uso críticos -->
    <logger name="app.application.usecase.ServiceDeliveryUseCase" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE_DEV"/>
    </logger>


    <!-- Reducir verbosidad de frameworks -->
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.hibernate" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="org.springframework.web" level="INFO"/>

    <!-- ===================================== -->
    <!-- PERFILES DE CONFIGURACIÓN            -->
    <!-- ===================================== -->

    <!-- Perfil de desarrollo (dev) -->
    <springProfile name="dev">
        <!-- Nivel DEBUG para ver todos los detalles -->
        <logger name="app" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE_DEV"/>
        </logger>

        <!-- Mostrar queries SQL en desarrollo -->
        <logger name="org.hibernate.SQL" level="DEBUG"/>
        <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="TRACE"/>

        <root level="INFO">
            <appender-ref ref="CONSOLE_DEV"/>
        </root>
    </springProfile>

    <!-- Perfil de producción (prod) -->
    <springProfile name="prod">
        <!-- Nivel INFO para reducir ruido en producción -->
        <logger name="app" level="INFO" additivity="false">
            <appender-ref ref="JSON_CONSOLE"/>
        </logger>

        <!-- NO mostrar logs de Hibernate en producción -->
        <logger name="org.hibernate.SQL" level="WARN"/>

        <!-- Logs a consola (Cloud Run captura stdout/stderr) -->
        <root level="WARN">
            <appender-ref ref="JSON_CONSOLE"/>
        </root>
    </springProfile>

    <!-- Configuración por defecto (cuando no hay perfil activo o perfiles no dev/prod) -->
    <springProfile name="default, !dev &amp; !prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE_DEV"/>
        </root>
    </springProfile>

</configuration>
