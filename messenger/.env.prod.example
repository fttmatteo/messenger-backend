# ============================================
# VARIABLES DE ENTORNO - PRODUCCIÓN
# ============================================
# Copiar este archivo a .env.prod y configurar con valores reales
# NUNCA commitear este archivo con valores reales a Git
# ============================================

# ============================================
# Dominio y SSL
# ============================================
DOMAIN_NAME=messenger.tudominio.com

# ============================================
# Base de Datos MySQL
# ============================================
DB_HOST=messenger-db
DB_PORT=3306
DB_NAME=messenger_prod
DB_USERNAME=messenger_app
DB_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO
DB_ROOT_PASSWORD=CAMBIAR_POR_ROOT_PASSWORD_SEGURO

# ============================================
# JWT Autenticación
# ============================================
# IMPORTANTE: Debe tener mínimo 32 caracteres
JWT_SECRET=CAMBIAR_POR_CLAVE_SECRETA_MINIMO_32_CARACTERES_PRODUCCION

# ============================================
# Redis
# ============================================
REDIS_HOST=messenger-redis
REDIS_PORT=6379
REDIS_PASSWORD=CAMBIAR_POR_REDIS_PASSWORD_SEGURO

# ============================================
# Google Cloud Platform
# ============================================
GOOGLE_MAPS_API_KEY=TU_API_KEY_DE_GOOGLE_MAPS
GCS_BUCKET_NAME=tu-bucket-de-produccion
GCP_PROJECT_ID=tu-proyecto-gcp
GOOGLE_CREDENTIALS_FILE=./google-credentials.json

# ============================================
# CORS y WebSocket
# ============================================
CORS_ALLOWED_ORIGINS=https://messenger.tudominio.com,https://app.tudominio.com
WEBSOCKET_ALLOWED_ORIGINS=https://messenger.tudominio.com,https://app.tudominio.com
