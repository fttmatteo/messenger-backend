# ============================================
# MESSENGER BACKEND - Variables de Entorno
# ============================================
# Copiar este archivo a .env y configurar los valores REALES
# IMPORTANTE: Nunca subir el archivo .env al repositorio

# Perfil de Spring Boot - Opciones: local, dev, prod, test
SPRING_PROFILES_ACTIVE=dev

# Base de Datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=messenger_dev
DB_USERNAME=root
DB_PASSWORD=secret

# JWT Authentication - Generar nueva clave con: openssl rand -base64 32
JWT_SECRET=change-me-to-a-secure-secret-key-minimum-256-bits

# Redis - Tracking en tiempo real
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=secret

# Google Cloud Platform - Ruta ABSOLUTA al archivo de credenciales de servicio JSON
GOOGLE_APPLICATION_CREDENTIALS=/ruta/a/tus/credenciales.json

# Google Maps API
GOOGLE_MAPS_API_KEY=AIzaSymockkey123456789

# Google Cloud Storage
GCS_BUCKET_NAME=nombre-de-tu-bucket
GCP_PROJECT_ID=id-de-tu-proyecto

# WebSocket - CORS
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Configuración de Logs (opcional)
LOG_PATH=./logs
APP_NAME=messenger-backend
