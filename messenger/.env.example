# ============================================
# MESSENGER BACKEND - Variables de Entorno
# ============================================
# Copiar este archivo a .env y configurar los valores
# IMPORTANTE: Nunca subir .env al repositorio
# ============================================

# ============================================
# Perfil de Spring Boot
# ============================================
# Opciones: local, dev, prod, test
SPRING_PROFILES_ACTIVE=dev

# ============================================
# Base de Datos MySQL
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=messenger_dev
DB_USERNAME=root
DB_PASSWORD=tu_password_seguro

# ============================================
# JWT Authentication
# ============================================
# IMPORTANTE: Generar clave segura de al menos 256 bits
# Ejemplo: openssl rand -base64 32
JWT_SECRET=tu-clave-secreta-super-segura-minimo-256-bits

# ============================================
# Redis (Tracking en tiempo real)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# Google Cloud Platform
# ============================================
# Ruta al archivo de credenciales de servicio
# Descargar desde: Google Cloud Console > IAM > Service Accounts
GOOGLE_APPLICATION_CREDENTIALS=/ruta/a/tu/service-account.json

# ============================================
# Google Maps API
# ============================================
# Obtener desde: Google Cloud Console > APIs & Services > Credentials
GOOGLE_MAPS_API_KEY=tu-api-key-de-google-maps

# ============================================
# Google Cloud Storage
# ============================================
GCS_BUCKET_NAME=messenger-backend-photos
GCP_PROJECT_ID=tu-project-id

# ============================================
# WebSocket (para producción)
# ============================================
WEBSOCKET_ALLOWED_ORIGINS=https://tu-dominio.com,https://app.tu-dominio.com

# ============================================
# Configuración de Logs (opcional)
# ============================================
LOG_PATH=./logs
APP_NAME=messenger-backend
