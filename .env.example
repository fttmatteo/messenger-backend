# ============================================
# MESSENGER BACKEND - Variables de Entorno
# ============================================
# 
# INSTRUCCIONES:
# 1. Copiar este archivo a .env en la RAÍZ del proyecto (junto a docker-compose.yml)
# 2. Configurar los valores según tu entorno
# 3. NUNCA subir el archivo .env al repositorio
#
# Para ejecutar: docker-compose up --build
# ============================================

# Perfil de Spring Boot
# Opciones: local (sin APIs externas), dev (con APIs), prod, test
SPRING_PROFILES_ACTIVE=dev

# ============================================
# BASE DE DATOS - MySQL
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=messenger_dev
DB_USERNAME=root
DB_PASSWORD=tu_password_seguro

# Cloud SQL (solo para producción en GCP)
CLOUD_SQL_CONNECTION_NAME=project-id:region:instance-name

# ============================================
# AUTENTICACIÓN - JWT
# ============================================
# Generar clave segura con: openssl rand -base64 32
JWT_SECRET=cambiar-por-clave-segura-minimo-256-bits

# ============================================
# REDIS - Cache y Tracking
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=tu_password_redis

# ============================================
# GOOGLE CLOUD PLATFORM
# ============================================
# Ruta ABSOLUTA al archivo de credenciales de servicio JSON
# IMPORTANTE: Usar barras normales (/) en ambos sistemas operativos
#
# ┌─────────────────────────────────────────────────────────────┐
# │ WINDOWS - Ejemplos:                                         │
# │   C:/Users/tu_usuario/credentials/gcp-credentials.json      │
# │   C:/ruta/sin/espacios/credentials.json                     │
# │                                                             │
# │ ⚠️  Evitar rutas con espacios o usar comillas si es necesario │
# └─────────────────────────────────────────────────────────────┘
#
# ┌─────────────────────────────────────────────────────────────┐
# │ MAC / LINUX - Ejemplos:                                     │
# │   /Users/tu_usuario/credentials/gcp-credentials.json        │
# │   /home/usuario/.config/gcloud/credentials.json             │
# └─────────────────────────────────────────────────────────────┘
#
GOOGLE_APPLICATION_CREDENTIALS=/ruta/a/tus/credenciales.json

# Google Maps API
GOOGLE_MAPS_API_KEY=AIzaSy_tu_api_key_aqui

# Google Cloud Storage
GCS_BUCKET_NAME=nombre-de-tu-bucket
GCP_PROJECT_ID=id-de-tu-proyecto-gcp

# ============================================
# CORS - Orígenes Permitidos
# ============================================
# Separar múltiples orígenes con comas si es necesario
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ============================================
# CONFIGURACIÓN ADICIONAL (Opcional)
# ============================================
LOG_PATH=./logs
APP_NAME=messenger-backend
