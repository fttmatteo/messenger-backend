# MESSENGER BACKEND - Variables de Entorno
# Copiar este archivo a .env y configurar los valores REALES
# IMPORTANTE: Nunca subir el archivo .env al repositorio

# Perfil de Spring Boot - Opciones: local, dev, prod, test
SPRING_PROFILES_ACTIVE=dev

# Base de Datos (Cloud SQL usa Socket Factory en Prod, ignorando Host/Port)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=messenger_dev
DB_USERNAME=root
DB_PASSWORD=tu_password_seguro
CLOUD_SQL_CONNECTION_NAME=project-id:region:instance-name

# JWT Authentication - Generar nueva clave con: openssl rand -base64 32
JWT_SECRET=cambiar-por-clave-segura-minimo-256-bits

# Redis - Tracking en tiempo real
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=tu_password_redis

# Google Cloud Platform
# Ruta ABSOLUTA al archivo de credenciales de servicio JSON
# IMPORTANTE: Usar barras normales (/) en ambos sistemas operativos
#
# ┌─────────────────────────────────────────────────────────────┐
# │ WINDOWS - Ejemplos:                                         │
# │   C:/Users/tu_usuario/credentials/gcp-credentials.json      │
# │   C:/ruta/sin/espacios/credentials.json                     │
# │                                                             │
# │ ⚠️  Evitar rutas con espacios o usar comillas si es necesario │
# └─────────────────────────────────────────────────────────────┘
#
# ┌─────────────────────────────────────────────────────────────┐
# │ MAC / LINUX - Ejemplos:                                     │
# │   /Users/tu_usuario/credentials/gcp-credentials.json        │
# │   /home/usuario/.config/gcloud/credentials.json             │
# └─────────────────────────────────────────────────────────────┘
#
GOOGLE_APPLICATION_CREDENTIALS=/ruta/a/tus/credenciales.json

# Plate Recognizer API
PLATE_RECOGNIZER_TOKEN=

# Google Maps API
GOOGLE_MAPS_API_KEY=AIzaSy_tu_api_key_aqui

# Google Cloud Storage
GCS_BUCKET_NAME=nombre-de-tu-bucket
GCP_PROJECT_ID=id-de-tu-proyecto-gcp

# WebSocket - CORS
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Configuración de Logs (opcional)
LOG_PATH=./logs
APP_NAME=messenger-backend

# Cloudflare Turnstile (Anti-Bot Verification)
# Obtener en: https://dash.cloudflare.com → Turnstile
TURNSTILE_SECRET_KEY=0x4AAAAAAAyyyyyyyyyyyyyyy

# WhatsApp Business API (Oficial - Cloud API)
# Obtener en: https://developers.facebook.com
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id
WHATSAPP_ACCESS_TOKEN=tu_access_token_permanente
WHATSAPP_VERIFY_TOKEN=tu_token_de_verificacion_inventado
WHATSAPP_APP_SECRET=tu_app_secret_de_facebook
WHATSAPP_SESSION_EXPIRATION_HOURS=12
